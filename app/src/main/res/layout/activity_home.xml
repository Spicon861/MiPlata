<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:padding="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_logo"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="MiPlata"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink_primary"/>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/ink_secondary"
                    android:layout_marginEnd="16dp"/>

                <View
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle"/>

            </LinearLayout>

            <!-- Contenido con padding -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Saludo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¡Hola, Sofía! 👋"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Noviembre 2024 • Finanzas bajo control"
                    android:textSize="12sp"
                    android:textColor="@color/ink_secondary"/>

                <View android:layout_width="match_parent" android:layout_height="16dp"/>

                <!-- Balance Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_gradient_balance"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="BALANCE TOTAL DISPONIBLE"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:alpha="0.9"/>

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_pill_white"
                            android:padding="7dp"
                            android:src="@drawable/ic_visibility"
                            app:tint="#FFFFFF"/>

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="12dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$"
                            android:textSize="18sp"
                            android:textColor="#FFFFFF"
                            android:alpha="0.8"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4,850.50"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="4dp"
                            android:text="USD"
                            android:textSize="11sp"
                            android:textColor="#FFFFFF"
                            android:alpha="0.8"/>

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="16dp"/>

                    <!-- Ingresos / Gastos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_pill_white"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_pill_white"
                                android:padding="6dp"
                                android:src="@drawable/ic_arrow_down"
                                app:tint="#FFFFFF"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ingresos"
                                    android:textSize="10sp"
                                    android:textColor="#FFFFFF"
                                    android:alpha="0.8"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="+$3,200.00"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"/>

                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_pill_white"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_pill_white"
                                android:padding="6dp"
                                android:src="@drawable/ic_arrow_up"
                                app:tint="#FFFFFF"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Gastos"
                                    android:textSize="10sp"
                                    android:textColor="#FFFFFF"
                                    android:alpha="0.8"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-$1,450.20"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"/>

                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="16dp"/>

                <!-- Meta de Ahorro -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_white"
                    android:padding="16dp"
                    android:elevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/brand_light"
                            android:padding="8dp"
                            android:src="@drawable/ic_beach"
                            app:tint="@color/brand_primary"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vacaciones Tokio 2025"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/ink_primary"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$2,040 de $3,000 acumulado"
                                android:textSize="11sp"
                                android:textColor="@color/ink_secondary"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="68%"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_primary"
                            android:background="@color/brand_light"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"/>

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="10dp"/>

                    <ProgressBar
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="68"
                        android:progressTint="@color/brand_primary"
                        android:progressBackgroundTint="@color/surface_container_high"/>

                    <View android:layout_width="match_parent" android:layout_height="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↗ Meta proyectada para Febrero"
                        android:textSize="11sp"
                        android:textColor="@color/ink_secondary"/>

                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="16dp"/>

                <!-- Flujo Semanal (Gráfico) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_white"
                    android:padding="16dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Flujo Semanal"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Promedio diario: $85.40"
                        android:textSize="11sp"
                        android:textColor="@color/ink_secondary"/>

                    <View android:layout_width="match_parent" android:layout_height="12dp"/>

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/weeklyBarChart"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"/>

                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="16dp"/>

                <!-- Movimientos Recientes -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Movimientos Recientes"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver todos ›"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_primary"/>

                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="10dp"/>

                <!-- Lista de transacciones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp"
                    android:padding="6dp">

                    <!-- Item 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/amber_bg"
                            android:padding="9dp"
                            android:src="@drawable/ic_shopping_cart"
                            app:tint="@color/amber_text"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Supermercado Éxito"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/ink_primary"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Alimentación • Hoy, 14:32"
                                android:textSize="11sp"
                                android:textColor="@color/ink_secondary"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-$84.20"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/ink_primary"/>

                    </LinearLayout>

                    <!-- Item 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/brand_light"
                            android:padding="9dp"
                            android:src="@drawable/ic_payments"
                            app:tint="@color/brand_primary"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pago de Nómina Quincenal"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/ink_primary"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ingreso • Ayer, 09:00"
                                android:textSize="11sp"
                                android:textColor="@color/ink_secondary"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+$1,600.00"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_primary"/>

                    </LinearLayout>

                    <!-- Item 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/red_bg"
                            android:padding="9dp"
                            android:src="@drawable/ic_movie"
                            app:tint="@color/tertiary_red"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Suscripción Netflix"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/ink_primary"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Entretenimiento • 12 Nov"
                                android:textSize="11sp"
                                android:textColor="@color/ink_secondary"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-$14.99"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/ink_primary"/>

                    </LinearLayout>

                    <!-- Item 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/blue_bg"
                            android:padding="9dp"
                            android:src="@drawable/ic_gas_station"
                            app:tint="@color/blue_text"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gasolina Shell"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/ink_primary"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Transporte • 10 Nov"
                                android:textSize="11sp"
                                android:textColor="@color/ink_secondary"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-$45.00"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/ink_primary"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        app:itemIconTint="@color/bottom_nav_colors"
        app:itemTextColor="@color/bottom_nav_colors"
        app:menu="@menu/bottom_nav_menu"
        app:elevation="8dp"/>

</RelativeLayout>